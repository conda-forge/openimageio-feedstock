From: conda-forge <conda-forge@users.noreply.github.com>
Subject: [PATCH] Use portable errno messages in the LibRaw reader

strerror_r is unavailable on Windows and its GNU variant returns a pointer,
not the integer status expected here. Use the standard C++ errno category.

--- a/src/raw.imageio/rawinput.cpp
+++ b/src/raw.imageio/rawinput.cpp
@@ -6,6 +6,7 @@
 #include <ctime> /* time_t, struct tm, gmtime */
 #include <iostream>
 #include <memory>
+#include <system_error>
 
 #include <OpenImageIO/half.h>
 
@@ -303,11 +304,8 @@
         if (const char* m = libraw_strerror(ret))
             msg = m;
     } else if (ret > 0) {
-        // C style error code, use safe version of strerror
-        const size_t maxbuf = 100;
-        char buf[maxbuf]    = { 0 };
-        if (strerror_r(ret, buf, maxbuf) == 0)
-            msg = std::string(buf);
+        // Use the portable C++ lookup for errno values, including on Windows.
+        msg = std::generic_category().message(ret);
     } else if (ret == 0) {
         msg = "ok";  // 0 means "no error"
     }
